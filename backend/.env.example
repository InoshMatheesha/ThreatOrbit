# Copy to backend/.env and fill in. Never commit real credentials.

# --- Server ---------------------------------------------------------------
NODE_ENV=development
# No authentication yet: keep the API on loopback.
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
# Must be explicitly enabled to bind beyond localhost (not recommended until auth exists).
ALLOW_UNAUTHENTICATED_REMOTE=

# --- Input limits -----------------------------------------------------------
# Maximum unique, provider-eligible indicators per batch.
MAX_BATCH_SIZE=500
MAX_INPUT_LINES=20000
# Applies to uploaded files and pasted text (bytes).
MAX_UPLOAD_BYTES=2097152
API_RATE_LIMIT_PER_MINUTE=300

# --- Storage and queue (used from Stage 2) ---------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/threat_intel_hub
REDIS_URL=redis://127.0.0.1:6379

# --- Secrets at rest ----------------------------------------------------------
# Encrypts API keys stored in the database (provider key pool, AI key). At least 32
# random characters, e.g. `openssl rand -base64 48`. Required in production; keep it
# safe, since changing it makes stored keys unreadable. In development a key file is
# generated under backend/.data/ when this is blank (ENCRYPTION_KEY_FILE sets its path).
ENCRYPTION_KEY=

# --- Threat intel providers (used from Stage 3) -----------------------------
# Leave blank to mark a provider as "unconfigured". Results are never fabricated.
# Administrators can add more keys per provider on the Sources page; lookups then
# rotate across all keys and run in parallel, one worker per key.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
URLHAUS_AUTH_KEY=

# VirusTotal reanalysis ("Include Reanalysis" when starting a batch): time between
# checks for the fresh analysis, and the longest wait before the latest one is used.
REANALYSIS_POLL_MS=45000
REANALYSIS_MAX_WAIT_MS=240000

