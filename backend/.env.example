# Copy to backend/.env and fill in. Never commit real credentials.
# Every setting below has a sensible default; only the API keys need filling in.

# --- Server ---------------------------------------------------------------
NODE_ENV=development
# No authentication yet: keep the API on loopback.
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
# Must be explicitly enabled to bind beyond localhost (not recommended until auth exists).
ALLOW_UNAUTHENTICATED_REMOTE=false

# --- Input limits -----------------------------------------------------------
# Maximum unique, provider-eligible indicators per batch.
MAX_BATCH_SIZE=500
MAX_INPUT_LINES=20000
# Applies to uploaded files and pasted text (bytes).
MAX_UPLOAD_BYTES=2097152
API_RATE_LIMIT_PER_MINUTE=300

# --- Storage and queue --------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/threat_intel_hub
# If MONGODB_URI is unreachable, start a local MongoDB (downloaded on first use)
# whose data persists in EMBEDDED_MONGODB_DIR. Set to false to require MONGODB_URI.
MONGODB_EMBEDDED_FALLBACK=true
EMBEDDED_MONGODB_DIR=.data/mongodb
REDIS_URL=redis://127.0.0.1:6379
# auto = BullMQ on Redis when reachable, otherwise the in-process development queue.
# bullmq = require Redis. memory = always use the in-process queue.
QUEUE_MODE=auto

# --- Enrichment -------------------------------------------------------------------
# Reuse a provider's answer for the same indicator for this long.
CACHE_TTL_HOURS=24
PROVIDER_TIMEOUT_MS=15000
LOOKUP_MAX_ATTEMPTS=4
RETRY_BASE_DELAY_MS=2000
# Optional JSON file overriding the default risk thresholds (see README).
# RISK_RULES_PATH=./risk-rules.json

# --- Retention --------------------------------------------------------------------
RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=180

# --- Threat intel providers -------------------------------------------------------
# Leave blank to mark a provider as "unconfigured". Results are never fabricated.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
URLHAUS_AUTH_KEY=
GREYNOISE_API_KEY=
# Comma-separated provider ids to switch off even with a key (virustotal,abuseipdb,otx,urlhaus,greynoise).
PROVIDERS_DISABLED=

# Rate limits default to each provider's free tier. Raise them for paid plans, e.g.:
# VIRUSTOTAL_REQUESTS_PER_MINUTE=4
# VIRUSTOTAL_DAILY_LIMIT=500
# ABUSEIPDB_DAILY_LIMIT=1000
# GREYNOISE_DAILY_LIMIT=50
