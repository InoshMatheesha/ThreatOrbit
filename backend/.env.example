# Copy to backend/.env for local development. Never commit real credentials.
# In production (Vercel), set these as environment variables in the project settings instead.

# --- Server ---------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
# Reverse proxies in front of the app: 0 locally (set automatically on Vercel).
TRUST_PROXY=0
# Origins allowed to make state-changing requests, comma-separated (e.g. https://threatorbit.vercel.app).
# Empty = same host only.
ALLOWED_ORIGINS=

# --- Accounts ---------------------------------------------------------------
# First admin, created on startup only while no users exist. Password: 12+ characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
SESSION_TTL_HOURS=12
# Defaults to true when NODE_ENV=production (HTTPS only).
# COOKIE_SECURE=false

# --- Input limits -----------------------------------------------------------
MAX_BATCH_SIZE=500
MAX_INPUT_LINES=20000
MAX_UPLOAD_BYTES=2097152
API_RATE_LIMIT_PER_MINUTE=300

# --- Storage and queue --------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/threat_intel_hub
# Development only: start a local MongoDB when MONGODB_URI is unreachable (off in production).
# MONGODB_EMBEDDED_FALLBACK=true
EMBEDDED_MONGODB_DIR=.data/mongodb
REDIS_URL=redis://127.0.0.1:6379
# auto = BullMQ when Redis answers, otherwise in-process. bullmq = require Redis. memory = in-process.
# database = queue in MongoDB, processed in short ticks (used automatically on Vercel).
QUEUE_MODE=auto
# Optional: lets an external scheduler advance the database queue via GET /api/cron/tick (16+ characters).
# CRON_SECRET=

# --- Enrichment -------------------------------------------------------------------
CACHE_TTL_HOURS=24
PROVIDER_TIMEOUT_MS=15000
LOOKUP_MAX_ATTEMPTS=4
RETRY_BASE_DELAY_MS=2000
# Optional JSON file overriding the default risk thresholds.
# RISK_RULES_PATH=./risk-rules.json

# --- Retention --------------------------------------------------------------------
RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=180

# --- Threat intel providers -------------------------------------------------------
# Leave blank to mark a provider as "unconfigured". Results are never fabricated.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
URLHAUS_AUTH_KEY=
# Comma-separated provider ids to switch off even with a key (virustotal,abuseipdb,otx,urlhaus).
PROVIDERS_DISABLED=

# Rate limits default to each provider's free tier. Raise them for paid plans, e.g.:
# VIRUSTOTAL_REQUESTS_PER_MINUTE=4
# VIRUSTOTAL_DAILY_LIMIT=500
# ABUSEIPDB_DAILY_LIMIT=1000

# --- Plain-English explanations (optional) ----------------------------------------
# An Anthropic API key switches on "Explain in plain English" for batches and indicators.
# Leave blank to keep the feature off. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# claude-opus-5-5 (default, best writing), claude-sonnet-5-5, or claude-haiku-5-5 (cheapest).
AI_MODEL=claude-opus-5-5
# New explanations per UTC day for the whole team. Saved ones are free.
AI_DAILY_LIMIT=100
