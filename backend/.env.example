# Copy to backend/.env and fill in. Never commit real credentials.

# --- Server ---------------------------------------------------------------
NODE_ENV=development
# No authentication yet: keep the API on loopback.
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
# Must be explicitly enabled to bind beyond localhost (not recommended until auth exists).
ALLOW_UNAUTHENTICATED_REMOTE=false

# --- Input limits -----------------------------------------------------------
# Maximum unique, provider-eligible indicators per batch.
MAX_BATCH_SIZE=500
MAX_INPUT_LINES=20000
# Applies to uploaded files and pasted text (bytes).
MAX_UPLOAD_BYTES=2097152
API_RATE_LIMIT_PER_MINUTE=300

# --- Storage and queue (used from Stage 2) ---------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/threat_intel_hub
REDIS_URL=redis://127.0.0.1:6379

# --- Threat intel providers (used from Stage 3) -----------------------------
# Leave blank to mark a provider as "unconfigured". Results are never fabricated.
VIRUSTOTAL_API_KEY=72fd4a27325b8b58b3df455818d9a62c01cd9b0f77e7f3d374de102161011145
ABUSEIPDB_API_KEY=b15547afa0cf84b75f6e8e5d746ee90720ee338d60449b8e0c445976e6095967f85aa564d976921f
OTX_API_KEY=e8797142b097bf4308fda139428f0e9a2760641436a96e89a4c9a7d360aac3d0
URLHAUS_AUTH_KEY=6262d2261958002d1ffd214811dea17e0475afa5d9754f5f

