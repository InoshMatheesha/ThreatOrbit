{
  "name": "threatorbit",
  "private": true,
  "description": "Threat Intel Hub: bulk IOC enrichment for SOC analysts",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start -w backend",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write \"backend/src/**/*.ts\" \"frontend/src/**/*.{ts,tsx,css}\" \"*.{json,yaml}\" \"frontend/*.{json,ts}\" \"backend/*.{json,ts}\"",
    "format:check": "prettier --check \"backend/src/**/*.ts\" \"frontend/src/**/*.{ts,tsx,css}\" \"*.{json,yaml}\" \"frontend/*.{json,ts}\" \"backend/*.{json,ts}\""
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10"
  }
}
